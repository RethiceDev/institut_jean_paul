# --- FeexPay (tableau de bord FeexPay > Développeurs) ---
# Clé privée : "test_key_..." en SANDBOX, "fp_..." en LIVE
FEEXPAY_API_KEY=
# Onglet "Identifiant" de la même page (identifiant de la boutique)
FEEXPAY_SHOP_ID=
# SANDBOX (tests, clés test_key_) ou LIVE (paiements réels, clés fp_)
FEEXPAY_MODE=SANDBOX
# Montant minimum accepté en FCFA (100 si vide)
FEEXPAY_MIN_AMOUNT=100

# --- Site ---
# URL publique du site, sans slash final (ex : https://paiement-jp2.vercel.app)
NEXT_PUBLIC_APP_URL=

# --- Notification de l'Institut (optionnel : le paiement fonctionne sans) ---
INSTITUTE_NOTIFICATION_EMAIL=

# Option A : Resend
RESEND_API_KEY=

# Option B : SMTP (utilisé si RESEND_API_KEY est vide)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur, ex : Institut Jean-Paul II <paiements@votre-domaine.bj>
MAIL_FROM=
